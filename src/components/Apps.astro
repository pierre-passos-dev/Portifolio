---
// src/components/Apps.astro
// Apps próprios (Campier). Vem logo depois do Hero: é o que eu crio e
// publico sozinho, do código à loja. Dados em src/data/apps.ts.
// Versão taste-skill: texto à esquerda e, à direita, o app de verdade: telas reais do
// Parcelas (as capturas da Play Store, recortadas em public/apps/parcelas-tela-*.webp).
import { useTranslations, type Lang } from '../i18n/translations';
import { apps, campier, type StatusApp } from '../data/apps';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const pt = lang === 'pt';

const textoStatus: Record<StatusApp, string> = pt
  ? { 'em-breve': 'Em breve', 'teste-fechado': 'Em teste no Google Play', 'na-loja': 'No Google Play' }
  : { 'em-breve': 'Coming soon', 'teste-fechado': 'In testing on Google Play', 'na-loja': 'On Google Play' };

// Telas reais do app em destaque (por enquanto só o Parcelas tem)
const telas: Record<string, { src: string; altPt: string; altEn: string }[]> = {
  parcelas: [
    {
      src: '/apps/parcelas-tela-1.webp',
      altPt: 'Tela do Parcelas com um financiamento de carro: saldo devedor, parcelas pagas, data de quitação, juros e a próxima parcela.',
      altEn: 'Parcelas screen with a car loan: balance due, installments paid, payoff date, interest and the next installment.',
    },
    {
      src: '/apps/parcelas-tela-4.webp',
      altPt: 'Tela do Parcelas com o gráfico do saldo devedor caindo ao longo do tempo e quanto foi para juros e amortização.',
      altEn: 'Parcelas screen with a chart of the balance falling over time and how much went to interest and principal.',
    },
  ],
};
---

<section class="section apps" id="apps">
  <div class="container">
    <span class="section-label">// {pt ? '01. apps próprios' : '01. my apps'}</span>
    <h2 class="section-title">{t('apps.title')}</h2>
    <p class="section-subtitle">&gt; {t('apps.sub')}</p>

    {apps.map(app => (
      <article class="grade app">
        <div class="grade__esq app__texto">
          <!-- A marca: quem publica o app -->
          <a class="marca" href={campier.site} target="_blank" rel="noopener">
            <svg class="marca__logo" viewBox="0 0 100 100" aria-hidden="true">
              <path d="M50 14 A36 36 0 1 1 18.82 32" fill="none" stroke="currentColor" stroke-width="11" stroke-linecap="round"/>
              <circle cx="32" cy="18.82" r="7.5" fill="#f5a524"/>
            </svg>
            <span class="marca__nome" translate="no">campier</span>
            <span class="marca__link" translate="no">campier.app ↗</span>
          </a>
          <p class="marca__texto">{t('apps.campier')}</p>

          <div class="app__topo">
            {app.icone
              ? <img class="app__icone" src={app.icone} alt="" width="56" height="56" loading="lazy" />
              : <span class="app__icone app__icone--letra" aria-hidden="true">{app.nome[0]}</span>}
            <div>
              <h3 class="app__nome" translate="no">{app.nome}</h3>
              <span class={`app__status app__status--${app.status}`}>
                <span class="app__ponto" aria-hidden="true"></span>{textoStatus[app.status]}
              </span>
            </div>
          </div>

          <p class="app__desc">{pt ? app.descPt : app.descEn}</p>

          <ul class="app__destaques">
            {(pt ? app.destaquesPt : app.destaquesEn).map(d => <li>{d}</li>)}
          </ul>

          <ul class="app__tags">
            {app.tags.map(tag => <li class="tag">{tag}</li>)}
          </ul>

          <div class="app__links">
            {app.play && (
              <a class="btn btn--primary" href={app.play} target="_blank" rel="noopener"><span>▶ Google Play</span></a>
            )}
            {app.site && (
              <a class={`btn ${app.play ? 'btn--ghost' : 'btn--primary'}`} href={app.site} target="_blank" rel="noopener">
                <span>{t('apps.conhecer')} {app.nome} ↗</span>
              </a>
            )}
          </div>
        </div>

        {telas[app.slug] && (
          <div class="grade__dir app__painel">
            {telas[app.slug].map((tela, i) => (
              <figure class={`celular celular--${i + 1}`}>
                <img src={tela.src} alt={pt ? tela.altPt : tela.altEn} width="480" height="912" loading="lazy" decoding="async" />
              </figure>
            ))}
          </div>
        )}
      </article>
    ))}
  </div>
</section>

<style>
.app { align-items: stretch; row-gap: 2.5rem; }
.app__texto { display: flex; flex-direction: column; gap: 1.25rem; }

/* Marca */
.marca {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  align-self: flex-start;
  min-height: 44px;
  color: var(--text-primary);
}
.marca__logo { width: 32px; height: 32px; }
.marca__nome { font-family: var(--font-display); font-size: 1.25rem; font-weight: 500; letter-spacing: 0.08em; }
.marca__link { font-family: var(--font-mono); font-size: 0.8125rem; letter-spacing: 0.1em; color: var(--accent); }
.marca:hover .marca__link { text-decoration: underline; text-underline-offset: 0.2em; }
.marca__texto { font-size: 1rem; line-height: 1.625; color: var(--tinta); max-width: 62ch; margin-top: -0.5rem; }

/* App */
.app__topo { display: flex; align-items: center; gap: 1rem; margin-top: 0.75rem; }
.app__icone { width: 56px; height: 56px; border-radius: 14px; flex: none; box-shadow: 0 6px 20px -6px rgba(0, 0, 0, 0.8); }
.app__icone--letra {
  display: grid; place-items: center;
  background: var(--bg-elevated);
  border: 1px solid var(--border-accent);
  font-family: var(--font-display);
  font-size: 1.4rem;
  color: var(--accent);
}
.app__nome { font-size: 1.25rem; letter-spacing: 0.08em; color: var(--text-primary); margin-bottom: 0.3rem; }
.app__status {
  display: inline-flex; align-items: center; gap: 0.5rem;
  font-family: var(--font-mono);
  font-size: 0.8125rem;
  letter-spacing: 0.08em;
  color: var(--accent-cool);
}
/* ponto parado: estado, não animação */
.app__ponto { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
.app__status--na-loja .app__ponto { background: #4ade80; }
.app__status--em-breve .app__ponto { background: var(--text-muted); }

.app__desc { color: var(--tinta); font-size: 1rem; line-height: 1.625; max-width: 62ch; }
.app__destaques { list-style: none; display: grid; gap: 0.4rem; color: var(--tinta); font-size: 1rem; line-height: 1.5; }
/* o "›" pendurado para fora: o texto alinha com o resto da coluna */
.app__destaques li { position: relative; }
.app__destaques li::before { content: '›'; position: absolute; left: -1rem; color: var(--accent); }
.app__tags { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; }
.app__links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: auto; padding-top: 0.5rem; }

/* O painel com o app: um campo âmbar aceso, as telas no tamanho de leitura, cortadas embaixo */
.app__painel {
  position: relative;
  min-height: 560px;
  overflow: hidden;
  border-radius: var(--radius-lg);
  background:
    radial-gradient(ellipse 70% 60% at 30% 20%, rgba(255, 179, 71, 0.30), transparent 70%),
    radial-gradient(ellipse 60% 70% at 85% 90%, rgba(255, 69, 0, 0.22), transparent 70%),
    linear-gradient(160deg, #2a1a0a 0%, #120c08 100%);
  box-shadow: inset 0 0 0 1px var(--fio), inset 0 1px 0 rgb(255 255 255 / 0.06);
}
/* Larguras em % da coluna e presos ao fundo: em qualquer tela os dois cabem lado a lado
   e a borda de baixo do painel sempre corta as telas (40px e 110px) */
.celular {
  position: absolute;
  width: 44%;
  margin: 0;
  border: 7px solid #15151b;
  border-bottom: 0;
  border-radius: 34px 34px 0 0;
  overflow: hidden;
  background: #15151b;
  box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.75), 0 0 0 1px rgba(255, 255, 255, 0.06);
}
.celular img { display: block; width: 100%; height: auto; border-radius: 27px 27px 0 0; }
.celular--1 { left: 4%; bottom: -40px; }
.celular--2 { right: 4%; bottom: -110px; }

@media (max-width: 1023px) {
  .app__painel { min-height: 520px; }
  .celular { width: 36%; }
  .celular--1 { left: 12%; }
  .celular--2 { right: 12%; }
}
/* Celular: uma tela só, no centro, grande o bastante para ler */
@media (max-width: 639px) {
  .app__painel { min-height: 440px; }
  .celular { width: 64%; border-width: 5px; border-radius: 26px 26px 0 0; }
  .celular img { border-radius: 21px 21px 0 0; }
  .celular--1 { left: 18%; bottom: -60px; }
  .celular--2 { display: none; }
}
</style>
