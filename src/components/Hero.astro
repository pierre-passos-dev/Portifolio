---
// src/components/Hero.astro
import { useTranslations, type Lang } from '../i18n/translations';
import { projects } from '../data/projects';
import { apps } from '../data/apps';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const totalProjetos = String(projects.length + apps.length).padStart(2, '0');
const cvHref = lang === 'pt' ? '/curriculo-pierre-passos.pdf' : '/resume-pierre-passos.pdf';
const roles = lang === 'pt'
  ? [t('hero.role'), 'Desenvolvedor Java', 'Desenvolvedor Angular', 'Desenvolvedor Ionic', 'Software + Hardware']
  : [t('hero.role'), 'Java Developer', 'Angular Developer', 'Ionic Developer', 'Software + Hardware'];
---

<section class="hero" id="hero">
  <!-- HUD corner decorations -->
  <div class="hud hud-tl" aria-hidden="true">
    <span class="hud-line-h"></span><span class="hud-line-v"></span>
  </div>
  <div class="hud hud-tr" aria-hidden="true">
    <span class="hud-line-h"></span><span class="hud-line-v"></span>
  </div>
  <div class="hud hud-bl" aria-hidden="true">
    <span class="hud-line-h"></span><span class="hud-line-v"></span>
  </div>
  <div class="hud hud-br" aria-hidden="true">
    <span class="hud-line-h"></span><span class="hud-line-v"></span>
  </div>

  <!-- Fundo em WebGL; a grade e os orbes abaixo são o que aparece sem ele -->
  <canvas class="hero__shader" aria-hidden="true"></canvas>

  <!-- Grid -->
  <div class="hero__grid" aria-hidden="true"></div>

  <!-- Floating neon orbs -->
  <div class="orb orb--1" aria-hidden="true"></div>
  <div class="orb orb--2" aria-hidden="true"></div>
  <div class="orb orb--3" aria-hidden="true"></div>

  <!-- HUD data strips -->
  <div class="hud-data hud-data--left" aria-hidden="true">
    <span>SYS.STATUS: ONLINE</span>
    <span>LOCATION: CURITIBA.BR</span>
    <span>STACK: JAVA.ANGULAR.IONIC</span>
    <span>MODE: FULLSTACK</span>
  </div>
  <div class="hud-data hud-data--right" aria-hidden="true">
    <span>BUILD: PROD</span>
    <span>UPTIME: 4Y+</span>
    <span>PROJECTS: {totalProjetos}</span>
    <span>STATUS: AVAILABLE</span>
  </div>

  <div class="container hero__content">
    <p class="hero__sys" aria-hidden="true">
      <span class="sys-icon">▶</span>
      <span id="sysText"></span>
      <span class="cursor-blink">_</span>
    </p>

    <!-- O h1 fica sempre com nome e cargo no HTML; o efeito de digitação é só visual.
         Os {' '} seguram o espaço, porque o compressHTML cola spans em linhas separadas. -->
    <h1 class="hero__heading">
      <span class="hero__name glitch" data-text="PIERRE" data-glitch-idle data-glitch-jump data-glitch-break>PIERRE</span>{' '}
      <span class="hero__surname">Passos</span>{' '}
      <span class="hero__title-wrap">
        <span class="hero__title-line" aria-hidden="true"></span>
        <span class="hero__title" id="heroRole">{t('hero.role')}</span>
        <span class="hero__title" id="typewriter" aria-hidden="true" data-roles={JSON.stringify(roles)} hidden></span>
      </span>
    </h1>

    <p class="hero__sub">
      <span class="sub-item">Java</span>
      <span class="sub-sep">//</span>
      <span class="sub-item">Angular</span>
      <span class="sub-sep">//</span>
      <span class="sub-item">Ionic</span>
      <span class="sub-sep">//</span>
      <span class="sub-item">Cloud</span>
    </p>

    <div class="hero__cta">
      <a href="#projects" class="btn btn--primary">
        <span>▶ {t('hero.cta')}</span>
      </a>
      <a href="#contact" class="btn btn--ghost">
        <span>{t('hero.contact')}</span>
      </a>
      <a href={cvHref} class="btn btn--ghost" download>
        <span>↓ {t('hero.cv')}</span>
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="hero__scroll" aria-hidden="true">
    <div class="scroll-track"><div class="scroll-thumb"></div></div>
    <span>SCROLL</span>
  </div>
</section>

<style>
.hero {
  position: relative;
  min-height: 100svh;
  display: flex;
  align-items: center;
  overflow: hidden;
}

/* Fundo em WebGL: entra suave por cima do fundo em CSS, que depois sai de cena */
.hero__shader {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.8s ease;
}
.hero.has-shader .hero__shader { opacity: 1; }
.hero.has-shader .hero__grid,
.hero.has-shader .orb {
  animation: none;
  visibility: hidden;
  transition: visibility 0s 0.9s;
}
/* Sem shader por opção ou limitação do aparelho: fundo em CSS, parado */
.hero.is-static .orb { animation: none; }

/* Grid */
.hero__grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255,140,0,0.07) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,140,0,0.07) 1px, transparent 1px);
  background-size: 60px 60px;
  mask-image: radial-gradient(ellipse 85% 80% at 50% 50%, black 30%, transparent 100%);
}

/* Orbs */
.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(100px);
  pointer-events: none;
}
.orb--1 {
  width: 600px; height: 600px;
  top: -200px; left: -200px;
  background: radial-gradient(circle, rgba(255,140,0,0.15) 0%, transparent 65%);
  animation: floatOrb 14s ease-in-out infinite;
}
.orb--2 {
  width: 450px; height: 450px;
  bottom: -100px; right: -150px;
  background: radial-gradient(circle, rgba(255,69,0,0.12) 0%, transparent 65%);
  animation: floatOrb 18s ease-in-out infinite reverse;
}
.orb--3 {
  width: 300px; height: 300px;
  top: 40%; left: 60%;
  background: radial-gradient(circle, rgba(255,179,71,0.08) 0%, transparent 65%);
  animation: floatOrb 10s ease-in-out infinite 3s;
}
@keyframes floatOrb {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33% { transform: translate(40px, -40px) scale(1.05); }
  66% { transform: translate(-20px, 30px) scale(0.95); }
}

/* HUD corners */
.hud {
  position: absolute;
  width: 40px; height: 40px;
  pointer-events: none;
  z-index: 2;
}
.hud-tl { top: 80px; left: 24px; }
.hud-tr { top: 80px; right: 24px; }
.hud-bl { bottom: 60px; left: 24px; }
.hud-br { bottom: 60px; right: 24px; }

.hud-line-h, .hud-line-v {
  position: absolute;
  background: rgba(255,140,0,0.6);
  box-shadow: 0 0 6px rgba(255,140,0,0.4);
}
.hud-line-h { width: 100%; height: 1px; top: 0; left: 0; }
.hud-line-v { width: 1px; height: 100%; top: 0; left: 0; }

.hud-tr .hud-line-v { left: auto; right: 0; }
.hud-bl .hud-line-h { top: auto; bottom: 0; }
.hud-br .hud-line-h { top: auto; bottom: 0; }
.hud-br .hud-line-v { left: auto; right: 0; }

/* HUD data strips */
.hud-data {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  font-family: var(--font-mono);
  font-size: 0.6rem;
  color: rgba(255,140,0,0.3);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  pointer-events: none;
}
.hud-data--left { left: 1.5rem; writing-mode: vertical-rl; transform: rotate(180deg) translateY(50%); }
.hud-data--right { right: 1.5rem; writing-mode: vertical-rl; }

@media (max-width: 900px) { .hud-data { display: none; } }

/* Content */
.hero__content {
  position: relative;
  z-index: 3;
  padding-top: 60px;
}

/* System line */
.hero__sys {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: rgba(255,140,0,0.6);
  letter-spacing: 0.1em;
  margin-bottom: 1.5rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  animation: fadeUp 0.5s ease both;
}
.sys-icon { color: var(--accent); }
.cursor-blink { animation: blink 1s step-end infinite; }
@keyframes blink { 50% { opacity: 0; } }

/* Name */
.hero__name {
  display: block;
  font-size: clamp(5rem, 16vw, 11rem);
  font-weight: 900;
  letter-spacing: -0.02em;
  line-height: 0.85;
  background: linear-gradient(135deg, #fff5e0 0%, #ff8c00 50%, #ff4500 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  position: relative;
}

/* Glitch: bigger shift, and solid split colors over the gradient text */
.hero__name { --glitch-shift: 10px; }
.hero__name::before, .hero__name::after { -webkit-text-fill-color: currentColor; }

/* Per-letter spans (added by JS for the break glitch) each carry a slice of the gradient */
.hero__name.is-split { background: none; white-space: nowrap; }
.hero__name :global(.glitch-char) {
  display: inline-block;
  background: linear-gradient(135deg, #fff5e0 0%, #ff8c00 50%, #ff4500 100%)
    var(--gx, 0) var(--gy, 0) / var(--gw, 100%) var(--gh, 100%) no-repeat;
  -webkit-background-clip: text;
  background-clip: text;
}

.hero__surname {
  display: block;
  margin-top: 0.9rem;
  font-size: clamp(1.5rem, 5vw, 3.4rem);
  font-weight: 700;
  letter-spacing: 0.42em;
  line-height: 1;
  color: var(--text-primary);
  animation: fadeUp 0.6s 0.1s ease both;
}

/* Role typewriter */
.hero__title-wrap {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-top: 1.5rem;
  margin-bottom: 0.75rem;
  /* dentro do h1: não herda o tamanho, o peso e a altura de linha do título */
  font-size: 1rem;
  font-weight: 400;
  line-height: 1.6;
  animation: fadeUp 0.6s 0.2s ease both;
}
/* O texto digitado fica no CSS: no HTML, entraria no texto do h1 */
#typewriter::before {
  content: attr(data-texto);
  content: attr(data-texto) / '';
}
/* some da tela quando a digitação assume, mas continua no h1 */
.hero__title.is-offscreen {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}
.hero__title-line {
  display: block;
  width: 3rem; height: 2px;
  background: var(--accent);
  box-shadow: 0 0 8px var(--accent);
  flex-shrink: 0;
}
.hero__title {
  font-family: var(--font-mono);
  font-size: clamp(1rem, 2.5vw, 1.4rem);
  color: var(--accent);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
/* Cursor no CSS: em um span, o "|" entraria no texto do h1 */
.hero__title-wrap::after {
  content: '|';
  content: '|' / '';
  color: var(--accent);
  font-family: var(--font-mono);
  animation: blink 0.8s step-end infinite;
}
/* "Desenvolvedor Full Stack" precisa caber em uma linha até nas telas de 320px */
@media (max-width: 480px) {
  .hero__title-wrap { gap: 0.6rem; }
  .hero__title-line { width: 1.25rem; }
  .hero__title { font-size: 0.9rem; letter-spacing: 0.05em; }
}

/* Sub */
.hero__sub {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
  margin-bottom: 2.5rem;
  animation: fadeUp 0.6s 0.3s ease both;
}
.sub-item {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--text-secondary);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.sub-sep {
  color: rgba(255,140,0,0.3);
  font-family: var(--font-mono);
  font-size: 0.75rem;
}

/* CTA */
.hero__cta {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  animation: fadeUp 0.6s 0.4s ease both;
}

/* Scroll */
.hero__scroll {
  position: absolute;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-mono);
  font-size: 0.55rem;
  color: rgba(255,140,0,0.4);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  animation: fadeUp 0.8s 0.8s ease both;
}
.scroll-track {
  width: 2px; height: 40px;
  background: rgba(255,140,0,0.15);
  position: relative;
  overflow: hidden;
}
.scroll-thumb {
  width: 100%; height: 40%;
  background: var(--accent);
  box-shadow: 0 0 6px var(--accent);
  position: absolute;
  top: -40%;
  animation: scrollThumb 2s ease-in-out infinite;
}
@keyframes scrollThumb {
  0% { top: -40%; }
  100% { top: 140%; }
}
/* Em tela baixa a indicação de rolagem ficaria em cima dos botões */
@media (max-height: 700px) { .hero__scroll { display: none; } }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24px); }
  to   { opacity: 1; transform: none; }
}
</style>

<script>
  /* Typewriter effect */
  const el = document.getElementById('typewriter')!;
  const roleEl = document.getElementById('heroRole')!;
  const roles: string[] = JSON.parse(el.dataset.roles!);
  let ri = 0, ci = roles[0].length, deleting = true;

  function typeLoop() {
    const word = roles[ri];
    el.dataset.texto = deleting ? word.slice(0, ci--) : word.slice(0, ci++);
    if (!deleting && ci > word.length) { setTimeout(() => { deleting = true; typeLoop(); }, 1800); return; }
    if (deleting && ci < 0) { deleting = false; ri = (ri + 1) % roles.length; ci = 0; }
    setTimeout(typeLoop, deleting ? 40 : 80);
  }
  // O cargo já vem escrito no HTML: fica na tela um tempo e só então a digitação assume
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    setTimeout(() => {
      el.dataset.texto = roles[0];
      el.hidden = false;
      roleEl.classList.add('is-offscreen');
      typeLoop();
    }, 2600);
  }

  /* System text */
  const sysEl = document.getElementById('sysText')!;
  const sysMsg = '> INITIALIZING SYSTEM... PIERREPASSOS.DEV';
  let si = 0;
  function sysType() {
    sysEl.textContent = sysMsg.slice(0, si++);
    if (si <= sysMsg.length) setTimeout(sysType, 35);
  }
  setTimeout(sysType, 200);

  /* Fundo em WebGL: só depois que a página abrir, para não atrasar o carregamento */
  const hero = document.getElementById('hero')!;
  const fundoParado = () => hero.classList.add('is-static');

  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    fundoParado();
  } else {
    const carregar = () => {
      import('../scripts/heroShader')
        .then(({ iniciarFundo }) => { if (!iniciarFundo(hero, fundoParado)) fundoParado(); })
        .catch(fundoParado);
    };
    const quandoOcioso = () => {
      if ('requestIdleCallback' in window) requestIdleCallback(carregar, { timeout: 1500 });
      else setTimeout(carregar, 200);
    };
    if (document.readyState === 'complete') quandoOcioso();
    else window.addEventListener('load', quandoOcioso, { once: true });
  }
</script>
