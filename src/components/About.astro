---
// src/components/About.astro
// Versão taste-skill: texto nas colunas 1 a 6 da grade e, a partir da 7, o cartão de terminal
// com o perfil, os números e a formação. Nada entra animando ao rolar; o cursor fica parado.
import { useTranslations, type Lang } from "../i18n/translations";
import { projects } from "../data/projects";
import { apps } from "../data/apps";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const pt = lang === "pt";
// Projetos profissionais + apps próprios.
const totalProjetos = projects.length + apps.length;
---

<section class="section about" id="about">
  <div class="container">
    <div class="grade about__inner">
      <div class="grade__esq about__text">
        <span class="section-label">// {pt ? "02. sobre" : "02. about"}</span>
        <h2 class="section-title">{t("about.title")}</h2>
        <p class="texto about__p">{t("about.p1")}</p>
        <p class="texto about__p">{t("about.p2")}</p>
        <p class="texto about__p">
          {t("about.p3")} <a class="about__link" href="#apps">{pt ? "Ver meus apps →" : "See my apps →"}</a>
        </p>
      </div>

      <div class="grade__dir about__right">
        <!-- O perfil em forma de terminal -->
        <div class="cartao terminal-card">
          <div class="terminal-bar" aria-hidden="true">
            <span class="t-dot t-dot--r"></span>
            <span class="t-dot t-dot--y"></span>
            <span class="t-dot t-dot--g"></span>
            <span class="t-title">pierre@system:~$</span>
          </div>
          <div class="terminal-body">
            <div class="t-line"><span class="t-prompt">$</span> whoami</div>
            <div class="t-line t-out">pierre_fullstack_dev</div>
            <div class="t-line"><span class="t-prompt">$</span> cat profile.json</div>
            <div class="t-code">
              <span class="t-brace">{"{"}</span><br />
              &nbsp;&nbsp;<span class="t-key">"name"</span>: <span class="t-val">"Pierre"</span>,<br />
              &nbsp;&nbsp;<span class="t-key">"xp"</span>: <span class="t-num">4</span>,<br />
              &nbsp;&nbsp;<span class="t-key">"projects"</span>: <span class="t-num">{totalProjetos}</span>,<br />
              &nbsp;&nbsp;<span class="t-key">"city"</span>: <span class="t-val">"Curitiba"</span>,<br />
              &nbsp;&nbsp;<span class="t-key">"stack"</span>: <span class="t-val">"Java+Angular"</span><br />
              <span class="t-brace">{"}"}</span>
            </div>
            <div class="t-line"><span class="t-prompt">$</span> status<span class="t-cursor" aria-hidden="true">_</span></div>
          </div>
        </div>

        <!-- Números: o mesmo estilo dos números dos projetos -->
        <div class="about__numeros">
          <p class="numero">
            <span class="numero__valor">4+</span>
            <span class="numero__rotulo">{pt ? "anos de experiência" : "years of experience"}</span>
          </p>
          <p class="numero">
            <span class="numero__valor">{totalProjetos}</span>
            <span class="numero__rotulo">{pt ? "projetos" : "projects"}</span>
          </p>
          <p class="numero">
            <span class="numero__valor">3</span>
            <span class="numero__rotulo">Web · Android · iOS</span>
          </p>
        </div>

        <!-- Formação -->
        <p class="edu-block">
          <span class="edu-course">
            {pt ? "Análise e Desenvolvimento de Sistemas · UNINTER" : "Systems Analysis and Development · UNINTER"}
          </span>
          <span class="edu-period">2021 – 2024</span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .about__inner { row-gap: 3rem; align-items: start; }

  .about__p { margin-top: 1.25rem; }
  .about__link {
    color: var(--accent);
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--transition);
  }
  .about__link:hover { text-decoration-color: currentColor; }

  /* O topo do terminal alinha com o título da esquerda */
  .about__right { display: grid; gap: 2rem; padding-top: 1.75rem; }

  /* Terminal */
  .terminal-card { overflow: hidden; }
  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--fio);
  }
  .t-dot { width: 9px; height: 9px; border-radius: 50%; }
  .t-dot--r { background: #ff5f56; }
  .t-dot--y { background: #ffbd2e; }
  .t-dot--g { background: #27c93f; }
  .t-title {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-left: 0.5rem;
    letter-spacing: 0.04em;
  }
  .terminal-body { padding: 1.25rem 1.5rem 1.5rem; }
  .t-line,
  .t-code {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.8;
    color: var(--tinta);
    letter-spacing: 0.02em;
  }
  .t-prompt { color: var(--accent); margin-right: 0.5rem; }
  .t-out { color: var(--accent-cool); padding-left: 1.5rem; }
  .t-code { padding: 0.25rem 1.5rem; }
  .t-brace { color: var(--text-muted); }
  .t-key { color: #ffb347; }
  .t-val { color: #98d982; }
  .t-num { color: #7ecfff; }
  .t-cursor { color: var(--accent); }

  /* Números lado a lado, nas linhas da coluna */
  .about__numeros {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  /* Formação: uma linha com fio em cima */
  .edu-block {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--fio);
    font-size: 1rem;
    line-height: 1.5;
  }
  .edu-course { color: var(--text-primary); }
  .edu-period { font-family: var(--font-mono); font-size: 0.875rem; color: var(--text-muted); letter-spacing: 0.06em; }

  @media (max-width: 1023px) {
    .about__right { padding-top: 0; }
  }
  /* Celular: os números empilham dois e um não fica bom; ficam um embaixo do outro em linha */
  @media (max-width: 479px) {
    .about__numeros { grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
    .about__numeros .numero { grid-template-columns: 4.5rem 1fr; align-items: baseline; column-gap: 1rem; }
    .about__numeros .numero__valor { font-size: 1.75rem; }
    .t-code { padding-inline: 0.75rem; }
  }
</style>
