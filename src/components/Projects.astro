---
// src/components/Projects.astro
// Versão de teste com o taste-skill (ramo teste-taste-projetos). Três blocos, cada um com o
// próprio título e cabendo em uma ou duas telas:
//   1. o projeto principal: o que é, um número real e a história (o diagrama virou a seção própria
//      "Arquitetura de referência", em ArquiteturaReferencia.astro);
//   2. as decisões técnicas do projeto principal, em lista;
//   3. os outros projetos, em cards de dois em dois.
// Os textos são os de src/data/projects.ts, sem reescrita (a reescrita depende da entrevista).
import { useTranslations, type Lang } from '../i18n/translations';
import { projects } from '../data/projects';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const pt = lang === 'pt';

const featured = projects.filter(p => p.featured);
const caso = featured.find(p => p.kind === 'case')!;
const outros = featured.filter(p => p.kind !== 'case');

---

<!-- 1. Projeto principal -->
<section class="section projetos" id="projects">
  <div class="container">
    <span class="section-label">// {pt ? '03. projetos' : '03. projects'}</span>
    <h2 class="section-title">{t('projects.title')}</h2>
    <p class="section-subtitle">&gt; {t('projects.sub')}</p>

    <article class="caso">
      <div class="grade caso__topo">
        <div class="grade__esq caso__texto">
          <span class="rotulo">// {t('projects.case')}</span>
          <h3 class="caso__titulo">{pt ? caso.titlePt : caso.titleEn}</h3>
          <p class="texto caso__desc">{pt ? caso.shortDescPt : caso.shortDescEn}</p>
          {caso.metaPt && <p class="meta">{pt ? caso.metaPt : caso.metaEn}</p>}
          <p class="caso__arq"><a href="#arquitetura">{pt ? 'Ver a arquitetura de referência ↓' : 'See the reference architecture ↓'}</a></p>
        </div>
        <div class="grade__dir caso__lado">
          {caso.stats?.map(s => (
            <p class="numero">
              <span class="numero__valor">{pt ? s.valorPt : s.valorEn}</span>
              <span class="numero__rotulo">{pt ? s.rotuloPt : s.rotuloEn}</span>
            </p>
          ))}
          <ul class="chips" aria-label="Stack">
            {caso.tags.map(tag => <li class="tag">{tag}</li>)}
          </ul>
        </div>
      </div>

      <dl class="historia">
        <div>
          <dt>{t('projects.problem')}</dt>
          <dd>{pt ? caso.problemPt : caso.problemEn}</dd>
        </div>
        <div>
          <dt>{t('projects.built')}</dt>
          <dd>
            {pt ? caso.builtPt : caso.builtEn}
            {caso.builtListPt && <ul class="lista">{(pt ? caso.builtListPt : caso.builtListEn!).map(item => <li>{item}</li>)}</ul>}
          </dd>
        </div>
        {caso.resultPt && (
          <div>
            <dt>{t('projects.impact')}</dt>
            <dd>{pt ? caso.resultPt : caso.resultEn}</dd>
          </div>
        )}
      </dl>
    </article>
  </div>
</section>

<!-- 2. Decisões técnicas do projeto principal -->
{caso.highlights && (
  <section class="section projetos" id="decisoes">
    <div class="container">
      <span class="section-label">// {t('projects.case')}</span>
      <h2 class="section-title">{t('projects.decisions')}</h2>
      <ol class="decisoes">
        {caso.highlights.map(h => (
          <li class="grade decisao">
            <h3 class="decisao__titulo">{pt ? h.titlePt : h.titleEn}</h3>
            <p class="texto decisao__texto">{pt ? h.textPt : h.textEn}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

<!-- 3. Outros projetos -->
<section class="section projetos" id="outros-projetos">
  <div class="container">
    <span class="section-label">// {pt ? '03. projetos' : '03. projects'}</span>
    <h2 class="section-title">{pt ? 'Outros projetos' : 'Other projects'}</h2>

    <div class="cards">
      {outros.map(p => (
        <article class="card">
          <h3 class="card__titulo">{pt ? p.titlePt : p.titleEn}</h3>
          {p.metaPt && <p class="meta">{pt ? p.metaPt : p.metaEn}</p>}
          <p class="texto card__desc">{pt ? p.shortDescPt : p.shortDescEn}</p>

          {p.stats && (
            <div class="card__numeros">
              {p.stats.map(s => (
                <p class="numero numero--card">
                  <span class="numero__valor">{pt ? s.valorPt : s.valorEn}</span>
                  <span class="numero__rotulo">{pt ? s.rotuloPt : s.rotuloEn}</span>
                </p>
              ))}
            </div>
          )}

          <ul class="chips" aria-label="Stack">
            {p.tags.map(tag => <li class="tag">{tag}</li>)}
          </ul>

          {(p.github || p.demo) && (
            <p class="card__links">
              {p.github && <a href={p.github} target="_blank" rel="noopener">GitHub ↗</a>}
              {p.demo && <a href={p.demo} target="_blank" rel="noopener">Demo ↗</a>}
            </p>
          )}

          <!-- Problema, o que fiz e resultado ficam guardados até a pessoa pedir -->
          <details class="card__detalhes">
            <summary class="mais">
              <span class="mais__abrir">{t('projects.more')}</span>
              <span class="mais__fechar">{t('projects.less')}</span>
            </summary>
            <dl class="historia historia--card">
              <div>
                <dt>{t('projects.problem')}</dt>
                <dd>{pt ? p.problemPt : p.problemEn}</dd>
              </div>
              <div>
                <dt>{t('projects.built')}</dt>
                <dd>
                  {pt ? p.builtPt : p.builtEn}
                  {p.builtListPt && <ul class="lista">{(pt ? p.builtListPt : p.builtListEn!).map(item => <li>{item}</li>)}</ul>}
                </dd>
              </div>
              {p.resultPt && (
                <div>
                  <dt>{t('projects.result')}</dt>
                  <dd>{pt ? p.resultPt : p.resultEn}</dd>
                </div>
              )}
            </dl>
            <!-- Fechar no fim do texto: o "Ver menos" do topo já saiu da tela depois de ler -->
            <button type="button" class="mais mais--fim">{t('projects.less')}</button>
          </details>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.mais--fim').forEach(btn => {
    btn.addEventListener('click', () => {
      const detalhes = btn.closest('details')!;
      detalhes.open = false;
      // Fechado, o card encolhe; se o topo dele ficou acima da tela, volta até ele,
      // descontando a navbar fixa
      const top = btn.closest<HTMLElement>('.card')!.getBoundingClientRect().top;
      if (top < 0) window.scrollBy({ top: top - 80 });
      detalhes.querySelector('summary')!.focus({ preventScroll: true });
    });
  });
</script>

<style>
/* As divisões em duas colunas usam a .grade do global.css: texto nas colunas 1 a 6,
   o resto a partir da 7, como nas outras seções */

.rotulo {
  display: block;
  font-family: var(--font-mono);
  font-size: 0.8125rem;
  color: var(--accent-cool);
  letter-spacing: 0.12em;
  text-transform: uppercase;
}
.meta {
  font-family: var(--font-mono);
  font-size: 0.8125rem;
  color: var(--text-muted);
  letter-spacing: 0.06em;
}

/* 1. Projeto principal */
.caso__lado { display: grid; gap: 1.5rem; align-content: start; }
.caso__titulo {
  font-size: 1.25rem;
  font-weight: 500;
  color: var(--text-primary);
  margin: 0.75rem 0 1rem;
  text-wrap: balance;
}
.caso__desc { margin-bottom: 0.75rem; }
.caso__arq { margin-top: 0.75rem; font-family: var(--font-mono); font-size: 0.8125rem; }
.caso__arq a { color: var(--accent); }
.caso__arq a:hover { text-decoration: underline; }

.chips { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; }

/* Problema, o que fiz, o que muda: três colunas nas linhas da grade */
.historia {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 2rem 24px;
  margin-top: 3rem;
}
.historia dt {
  font-family: var(--font-mono);
  font-size: 0.8125rem;
  color: var(--accent-cool);
  letter-spacing: 0.12em;
  text-transform: uppercase;
}
.historia dd {
  margin-top: 0.5rem;
  font-size: 1rem;
  line-height: 1.625;
  color: var(--tinta);
}
.lista { list-style: none; margin-top: 0.5rem; }
/* o "›" fica pendurado para fora: o texto da lista alinha com o título da coluna */
.lista li { position: relative; margin-top: 0.35rem; }
.lista li::before { content: '›'; position: absolute; left: -1rem; color: var(--accent); }

/* 2. Decisões técnicas: título à esquerda, texto a partir da coluna 7, um fio entre as linhas */
.decisoes { list-style: none; margin-top: 2rem; }
.decisao {
  padding: 1.5rem 0;
  border-top: 1px solid var(--fio);
}
.decisao:last-child { border-bottom: 1px solid var(--fio); }
.decisao__titulo {
  grid-column: 1 / span 6;
  padding-right: 2rem;
  font-size: 1.25rem;
  font-weight: 500;
  line-height: 1.3;
  color: var(--text-primary);
  text-wrap: balance;
}
.decisao__texto { grid-column: 7 / -1; }

/* 3. Outros projetos: cards de dois em dois, mesma altura por linha */
.cards {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24px;
  margin-top: 2rem;
}
.card {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  padding: 2rem;
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  box-shadow: inset 0 0 0 1px var(--fio), inset 0 1px 0 rgb(255 255 255 / 0.05);
}
/* Aberto, o card ocupa a linha toda e as três partes ficam lado a lado */
.card:has(> .card__detalhes[open]) { grid-column: 1 / -1; }
.card__titulo {
  font-size: 1.25rem;
  font-weight: 500;
  line-height: 1.3;
  color: var(--text-primary);
}
.card__titulo + .meta { margin-top: -0.5rem; }
.card__numeros { display: flex; flex-wrap: wrap; gap: 1rem 2.5rem; }
.numero--card .numero__valor { font-size: 1.75rem; }
.card__links { display: flex; gap: 1.25rem; font-family: var(--font-mono); font-size: 0.8125rem; }
.card__links a { color: var(--accent); }
.card__links a:hover { text-decoration: underline; text-underline-offset: 0.2em; }

.card__detalhes { margin-top: auto; }
.mais {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  min-height: 2.75rem;
  font-family: var(--font-mono);
  font-size: 0.8125rem;
  color: var(--accent);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  list-style: none;
  background: none;
  border: 0;
  padding: 0;
  cursor: url('/cursors/pointer.svg') 16 16, pointer;
}
.mais::-webkit-details-marker { display: none; }
.mais::before { content: '▶'; font-size: 0.6rem; transition: transform 0.2s; }
.card__detalhes[open] > .mais::before { transform: rotate(90deg); }
.mais--fim::before { transform: rotate(-90deg); }
.mais:hover { text-shadow: 0 0 8px var(--accent); }
.mais:focus-visible { outline: 1px solid var(--accent); outline-offset: 4px; }
.mais__fechar, .card__detalhes[open] .mais__abrir { display: none; }
.card__detalhes[open] .mais__fechar { display: inline; }
.historia--card { margin: 1rem 0 0.5rem; }

/* No computador, as decisões dão duas telas cheias (com os 7rem do topo da seção seguinte, a mesma
   conta do .section): rolando, a seção de baixo não aparece no fim da tela. O projeto principal
   não entra mais: sem o diagrama ele não enche duas telas e deixava um vazio de ~500px */
@media (min-width: 1024px) {
  #decisoes {
    min-height: calc(200vh - 7rem);
    min-height: calc(200svh - 7rem);
  }
}

/* Tablet: o texto do topo e o número empilham; as decisões também */
@media (max-width: 1023px) {
  .decisao__titulo, .decisao__texto { grid-column: 1 / -1; padding-right: 0; }
  .caso__lado { margin-top: 1.5rem; }
  .decisao__texto { margin-top: 0.5rem; }
  .historia { grid-template-columns: minmax(0, 1fr); }
}
/* Celular: uma coluna, cards com 24px de respiro */
@media (max-width: 639px) {
  .cards { grid-template-columns: minmax(0, 1fr); }
  .card { padding: 1.5rem; }
}
@media (min-width: 640px) and (max-width: 1023px) {
  .card { padding: 1.75rem; }
}
</style>
