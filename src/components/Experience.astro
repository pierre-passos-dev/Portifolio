---
// src/components/Experience.astro
// Versão taste-skill: uma lista com fio entre os empregos, como as Decisões dos projetos.
// Nas colunas 1 a 6: período, empresa, cargo, os resultados e a stack; a partir da 7, o que
// eu fazia. Sem linha do tempo com anel pulsando e sem entrada animada ao rolar.
// O texto em src/data/experience.ts é corrido (o currículo usa assim); aqui ele é separado
// em parágrafo, tópicos e "Resultados" para virar lista de verdade.
import { useTranslations, type Lang } from '../i18n/translations';
import { experiences } from '../data/experience';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const pt = lang === 'pt';

type Bloco = { titulo?: string; paragrafo?: string; itens?: string[] };

// Cada bloco é separado por linha em branco. Um bloco pode ter um título ("Resultados:")
// na primeira linha; as linhas que começam com "•" viram itens de lista.
function separar(desc: string): Bloco[] {
  return desc.split('\n\n').map(bloco => {
    const linhas = bloco.split('\n').map(l => l.trim()).filter(Boolean);
    const itens = linhas.filter(l => l.startsWith('•')).map(l => l.replace(/^•\s*/, ''));
    const resto = linhas.filter(l => !l.startsWith('•'));
    if (!itens.length) return { paragrafo: resto.join(' ') };
    return { titulo: resto[0]?.replace(/:$/, ''), itens };
  });
}

const empregos = experiences.map(exp => ({ ...exp, blocos: separar(pt ? exp.descPt : exp.descEn) }));
---

<section class="section experience" id="experience">
  <div class="container">
    <span class="section-label">// {pt ? '06. experiência' : '06. experience'}</span>
    <h2 class="section-title">{t('exp.title')}</h2>

    <ol class="empregos">
      {empregos.map(exp => (
        <li class="grade emprego">
          <div class="grade__esq emprego__topo">
            <p class="emprego__periodo">{pt ? exp.periodPt : exp.periodEn}</p>
            <h3 class="emprego__empresa">{exp.company}</h3>
            <p class="emprego__cargo">{pt ? exp.rolePt : exp.roleEn}</p>
            <!-- Os blocos com título ("Resultados") ficam aqui, embaixo do cargo -->
            {exp.blocos.filter(b => b.titulo).map(b => (
              <div class="emprego__bloco">
                <h4 class="emprego__titulo">{b.titulo}</h4>
                <ul class="emprego__lista">
                  {b.itens!.map(item => <li>{item}</li>)}
                </ul>
              </div>
            ))}
            <ul class="emprego__tags" aria-label="Stack">
              {exp.tags.slice(0, 6).map(tag => <li class="tag">{tag}</li>)}
            </ul>
          </div>

          <div class="grade__dir emprego__texto">
            {exp.blocos.filter(b => !b.titulo).map(b => (
              b.itens
                ? <ul class="emprego__lista">{b.itens.map(item => <li>{item}</li>)}</ul>
                : <p class="texto">{b.paragrafo}</p>
            ))}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
.empregos { list-style: none; margin-top: 2rem; }
.emprego {
  row-gap: 1rem;
  align-items: start;
  padding: 2rem 0 2.25rem;
  border-top: 1px solid var(--fio);
}
.emprego:last-child { border-bottom: 1px solid var(--fio); }

/* Esquerda: período, empresa, cargo, resultados e stack */
.emprego__topo { display: grid; gap: 0.5rem; align-content: start; padding-right: 2rem; }
.emprego__topo .emprego__bloco { margin-top: 1.25rem; }
.emprego__periodo {
  font-family: var(--font-mono);
  font-size: 0.8125rem;
  color: var(--accent-cool);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.emprego__empresa {
  font-size: 1.5rem;
  font-weight: 500;
  color: var(--text-primary);
}
.emprego__cargo { font-size: 1rem; line-height: 1.5; color: var(--tinta); }

/* Direita: parágrafo, tópicos e resultados */
.emprego__texto { display: grid; gap: 1.25rem; align-content: start; }
.emprego__titulo {
  font-family: var(--font-mono);
  font-size: 0.8125rem;
  font-weight: 400;
  color: var(--accent-cool);
  letter-spacing: 0.12em;
  margin-bottom: 0.5rem;
}
.emprego__lista {
  list-style: none;
  display: grid;
  gap: 0.4rem;
  max-width: 62ch;
  font-size: 1rem;
  line-height: 1.55;
  color: var(--tinta);
}
/* o "›" fica pendurado para fora: o texto da lista alinha com o parágrafo de cima */
.emprego__lista li { position: relative; }
.emprego__lista li::before { content: '›'; position: absolute; left: -1rem; color: var(--accent); }
.emprego__tags { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1.25rem; }

/* Tablet e celular: uma coluna só. As duas colunas se desfazem para reordenar:
   período, empresa e cargo; depois o que eu fazia; por fim resultados e stack */
@media (max-width: 1023px) {
  .emprego__topo, .emprego__texto { display: contents; }
  .emprego__topo > *, .emprego__texto > * { grid-column: 1 / -1; }
  .emprego__periodo, .emprego__empresa, .emprego__cargo { order: 0; }
  .emprego__empresa, .emprego__cargo { margin-top: -0.5rem; }
  .emprego__texto > * { order: 1; }
  .emprego__topo .emprego__bloco, .emprego__tags { order: 2; margin-top: 0.5rem; }
  .emprego__texto > :first-child { margin-top: 0.5rem; }
}
/* Celular: o "›" pendurado sairia da tela; entra um pouco */
@media (max-width: 479px) {
  .emprego__lista { padding-left: 1rem; }
}
</style>
