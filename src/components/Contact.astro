---
// src/components/Contact.astro
// Versão taste-skill: o convite e o e-mail nas colunas 1 a 6; a partir da 7, quatro cards
// com o logo de verdade de cada canal (Gmail, GitHub, LinkedIn e o PDF do currículo).
// Os cards sobem 2px ao passar o mouse. Logos em public/assets/icons.
import { useTranslations, type Lang } from '../i18n/translations';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const pt = lang === 'pt';

const emailSubject = pt ? 'Interesse em seu trabalho' : 'Interest in your work';
const emailBody    = pt
  ? 'Olá,\n\nVi seu portfólio e gostaria de conversar.'
  : 'Hi,\n\nI saw your portfolio and would like to connect.';
const cvHref = pt ? '/curriculo-pierre-passos.pdf' : '/resume-pierre-passos.pdf';
// No HTML, este link fica entre os comentários email_off: sem eles, o Cloudflare
// troca o mailto por um link que só funciona com JavaScript
const emailHref = `mailto:pierre.passos.dev@gmail.com?subject=${encodeURIComponent(emailSubject)}&body=${encodeURIComponent(emailBody)}`;
---

<section class="section contact" id="contact">
  <div class="contact__bg" aria-hidden="true">
    <div class="contact__orb"></div>
  </div>

  <div class="container">
    <span class="section-label">// {pt ? '07. contato' : '07. contact'}</span>
    <h2 class="section-title">{t('contact.title')}</h2>

    <div class="grade contact__inner">
      <div class="grade__esq contact__left">
        <p class="texto contact__sub">{t('contact.sub')}</p>
        <p class="contact__email-display">pierre.passos.dev<span class="e-at">@</span>gmail.com</p>
      </div>

      <div class="grade__dir contact__links">
        <!--email_off-->
        <a href={emailHref} class="cartao contact-card">
          <span class="logo"><img src="/assets/icons/gmail.svg" alt="" width="26" height="26" /></span>
          <span class="contact-card__text">
            <span class="contact-card__label">Email</span>
            <span class="contact-card__value">{t('contact.email')}</span>
          </span>
          <span class="contact-card__arrow" aria-hidden="true">↗</span>
        </a>
        <!--/email_off-->

        <a href="https://github.com/pierre-passos-dev" target="_blank" rel="noopener" class="cartao contact-card">
          <span class="logo"><img src="/assets/icons/github.svg" alt="" width="26" height="26" /></span>
          <span class="contact-card__text">
            <span class="contact-card__label">GitHub</span>
            <span class="contact-card__value">pierre-passos-dev</span>
          </span>
          <span class="contact-card__arrow" aria-hidden="true">↗</span>
        </a>

        <a href="https://www.linkedin.com/in/pierre-passos" target="_blank" rel="noopener" class="cartao contact-card">
          <span class="logo"><img src="/assets/icons/linkedin.svg" alt="" width="26" height="26" /></span>
          <span class="contact-card__text">
            <span class="contact-card__label">LinkedIn</span>
            <span class="contact-card__value">pierre-passos</span>
          </span>
          <span class="contact-card__arrow" aria-hidden="true">↗</span>
        </a>

        <a href={cvHref} class="cartao contact-card" download>
          <span class="logo"><img src="/assets/icons/pdf.svg" alt="" width="26" height="26" /></span>
          <span class="contact-card__text">
            <span class="contact-card__label">PDF</span>
            <span class="contact-card__value">{t('hero.cv')}</span>
          </span>
          <span class="contact-card__arrow" aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
.contact {
  position: relative;
  overflow: hidden;
  /* última seção: ela mais o rodapé (4rem de margem + 146px) dão uma tela,
     para o clique em "Contato" mostrar tudo até o fim da página */
  min-height: calc(100vh - 4rem - 146px);
  min-height: calc(100svh - 4rem - 146px);
  /* embaixo já vem a margem do rodapé; o espaço padrão da seção dobrava o vão
     e, em telas baixas, empurrava o fim da página para fora da tela */
  padding-bottom: 0;
}
@media (max-width: 600px) {
  /* no celular o rodapé empilha e fica com 223px */
  .contact { min-height: calc(100svh - 4rem - 223px); }
}
.contact__bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.contact__orb {
  position: absolute;
  bottom: -200px; right: -200px;
  width: 600px; height: 600px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,140,0,0.08) 0%, transparent 65%);
  filter: blur(60px);
}

.contact__inner { row-gap: 2.5rem; align-items: start; }

.contact__sub { font-size: 1.125rem; margin-bottom: 1.5rem; }
.contact__email-display {
  font-family: var(--font-mono);
  font-size: 1rem;
  color: var(--accent-cool);
  letter-spacing: 0.04em;
  overflow-wrap: anywhere;
}
.e-at { color: var(--accent); }

/* Cards de dois em dois, nas linhas da coluna; quando a coluna é estreita (1024 a 1279px)
   ou a tela é de celular, um por linha, para "pierre-passos-dev" não quebrar no meio */
.contact__links {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 16.5rem), 1fr));
  gap: 24px;
}

.contact-card {
  display: flex;
  align-items: center;
  gap: 1rem;
  min-height: 5.5rem;
  padding: 1.25rem;
  transition: transform var(--transition), box-shadow var(--transition);
}
/* sobe 2px e o fio acende em âmbar */
.contact-card:hover {
  transform: translateY(-2px);
  box-shadow: inset 0 0 0 1px var(--border-accent), inset 0 1px 0 rgb(255 255 255 / 0.05), 0 12px 24px -12px rgba(0, 0, 0, 0.8);
}
.contact-card:active { transform: translateY(0); }
.contact-card:focus-visible { outline: 1px solid var(--accent); outline-offset: 3px; }

.contact-card__text { flex: 1; min-width: 0; display: grid; gap: 0.15rem; }
.contact-card__label {
  font-family: var(--font-mono);
  font-size: 0.8125rem;
  color: var(--accent-cool);
  letter-spacing: 0.12em;
  text-transform: uppercase;
}
.contact-card__value {
  font-size: 1rem;
  line-height: 1.4;
  color: var(--text-primary);
  overflow-wrap: anywhere;
}
.contact-card__arrow {
  font-size: 1rem;
  color: var(--text-muted);
  transition: color var(--transition), transform var(--transition);
}
.contact-card:hover .contact-card__arrow { color: var(--accent); transform: translate(2px, -2px); }
.contact-card[download]:hover .contact-card__arrow { transform: translateY(2px); }

/* 1024 a 1279px: os quatro cards ficam um embaixo do outro; mais baixos, para o clique em
   "Contato" ainda mostrar a página até o fim do rodapé em telas de 768px de altura */
@media (min-width: 1024px) and (max-width: 1279px) {
  .contact__links { gap: 12px; }
  .contact-card { min-height: 4.5rem; padding-block: 0.875rem; }
}
/* Celular: um card por linha */
@media (max-width: 479px) {
  .contact__links { gap: 12px; }
  .contact-card { min-height: 4.5rem; }
}
</style>
