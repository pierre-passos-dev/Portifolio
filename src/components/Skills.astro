---
// src/components/Skills.astro
// Versão taste-skill: à esquerda (colunas 1 a 6) as principais, em lista, com o logo de verdade
// de cada tecnologia; à direita (a partir da 7) tudo o que uso, por área, e o que estou estudando.
// As tags não reagem ao mouse (não são botões) e nada se move sozinho.
// Logos em public/assets/icons (créditos em icons-credits.json).
import { useTranslations, type Lang } from "../i18n/translations";
import { coreSkills, currentSkills, learningSkills } from "../data/skills";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const pt = lang === "pt";

// Logo de cada principal (pelo nome em skills.ts). Java + Spring Boot leva o Spring de selo.
const logos: Record<string, { src: string; selo?: string }> = {
  "Java + Spring Boot": { src: "/assets/icons/java.svg", selo: "/assets/icons/spring.svg" },
  Angular: { src: "/assets/icons/angular.svg" },
  Ionic: { src: "/assets/icons/ionic-icon.svg" },
  TypeScript: { src: "/assets/icons/typescript.svg" },
  Azure: { src: "/assets/icons/azure.svg" },
};
---

<section class="section skills" id="skills">
  <div class="container">
    <span class="section-label">// {pt ? "05. habilidades" : "05. skills"}</span>
    <h2 class="section-title">{t("skills.title")}</h2>
    <p class="section-subtitle">
      {pt ? "> Principais tecnologias e arquiteturas" : "> Core technologies and architecture"}
    </p>

    <div class="grade skills__grade">
      <!-- As principais -->
      <div class="grade__esq">
        <h3 class="skills__rotulo">{pt ? "Principais" : "Core"}</h3>
        <ul class="principais">
          {coreSkills.map((skill) => (
            <li class="principal">
              <span class="principal__logo">
                <span class="logo">
                  <img src={logos[skill.name]?.src} alt="" width="26" height="26" loading="lazy" />
                </span>
                {logos[skill.name]?.selo && (
                  <span class="logo principal__selo">
                    <img src={logos[skill.name].selo} alt="" width="14" height="14" loading="lazy" />
                  </span>
                )}
              </span>
              <span class="principal__texto">
                <span class="principal__nome">{skill.name}</span>
                <span class="principal__nota">{pt ? skill.notePt : skill.noteEn}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Tudo o que uso, por área, e o que estou estudando -->
      <div class="grade__dir">
        <h3 class="skills__rotulo">{pt ? "Por área" : "By area"}</h3>
        <dl class="areas">
          {currentSkills.map((group) => (
            <div class="area">
              <dt class="area__nome">{group.key}</dt>
              <dd>
                <ul class="area__tags">
                  {group.items.map((item) => <li class="tag">{item}</li>)}
                </ul>
              </dd>
            </div>
          ))}
        </dl>

        <h3 class="skills__rotulo skills__rotulo--estudo">{pt ? "Estudando agora" : "Learning now"}</h3>
        <dl class="areas">
          {learningSkills.map((group) => (
            <div class="area">
              <dt class="area__nome">{group.key}</dt>
              <dd>
                <ul class="area__tags">
                  {group.items.map((item) => <li class="tag tag--estudo">{item}</li>)}
                </ul>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .skills__grade { row-gap: 3rem; align-items: start; }

  .skills__rotulo {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--accent-cool);
    letter-spacing: 0.12em;
    margin-bottom: 0.5rem;
  }
  .skills__rotulo--estudo { margin-top: 2.5rem; }

  /* As principais: logo, nome e nota, uma por linha, com fio entre elas */
  .principais { list-style: none; }
  .principal {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.125rem 0;
    border-top: 1px solid var(--fio);
  }
  .principal:last-child { border-bottom: 1px solid var(--fio); }
  .principal__logo { position: relative; flex: none; }
  /* o Spring no canto do Java, como um selo */
  .logo.principal__selo {
    --logo: 24px;
    position: absolute;
    right: -10px;
    bottom: -8px;
    border-radius: 7px;
    box-shadow: 0 0 0 2px var(--bg-base);
  }
  .logo.principal__selo img { width: 64%; height: 64%; }
  .principal__texto { display: grid; gap: 0.15rem; min-width: 0; }
  .principal__nome {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-primary);
  }
  .principal__nota { font-size: 1rem; line-height: 1.5; color: var(--tinta); }

  /* Por área: o nome da área numa coluna estreita e as tags ao lado */
  .area {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0.5rem 1rem;
    padding: 1rem 0;
    border-top: 1px solid var(--fio);
  }
  .areas > .area:last-child { border-bottom: 1px solid var(--fio); }
  .area__nome {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-secondary);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding-top: 0.2rem;
  }
  .area__tags { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  /* estudando: a mesma tag, num tom mais baixo e com borda tracejada */
  .tag.tag--estudo {
    color: var(--tinta);
    border-style: dashed;
    border-color: color-mix(in oklab, var(--text-primary) 28%, transparent);
    background: transparent;
  }

  /* Celular: o nome da área vai para cima das tags */
  @media (max-width: 479px) {
    .area { grid-template-columns: minmax(0, 1fr); }
  }
</style>
