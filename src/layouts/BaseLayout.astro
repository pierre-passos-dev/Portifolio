---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/translations';

interface Props {
  title?: string;
  description?: string;
  /** Páginas de erro não entram no índice nem declaram versões em outro idioma */
  noindex?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const {
  title = lang === 'pt' ? 'Pierre Passos — Desenvolvedor Full Stack' : 'Pierre Passos — Full Stack Developer',
  description = lang === 'pt'
    ? 'Desenvolvedor Fullstack especializado em Java, Angular, Ionic e sistemas enterprise.'
    : 'Fullstack Developer specialized in Java, Angular, Ionic and enterprise systems.',
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ptURL = new URL('/', Astro.site);
const enURL = new URL('/en/', Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
---

<!DOCTYPE html>
<html lang={lang} data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Pierre Passos" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  {noindex ? (
    <meta name="robots" content="noindex" />
  ) : (
    <>
      <meta name="robots" content="index, follow" />
      <link rel="canonical" href={canonicalURL} />
      <link rel="alternate" hreflang="pt-BR" href={ptURL} />
      <link rel="alternate" hreflang="en" href={enURL} />
      <link rel="alternate" hreflang="x-default" href={ptURL} />
    </>
  )}

  <!-- Prévia de link (LinkedIn, WhatsApp, X...) -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Pierre Passos" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={lang === 'pt' ? 'Pierre Passos — Desenvolvedor Full Stack' : 'Pierre Passos — Full Stack Developer'} />
  <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
  <meta property="og:locale:alternate" content={lang === 'pt' ? 'en_US' : 'pt_BR'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Fontes: link no head em vez de @import no CSS, que só baixava depois do CSS -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;600;700;800;900&family=Rajdhani:wght@300;400;500;600;700&display=swap"
  />
</head>
<body>
  <!-- Particle canvas -->
  <canvas id="particle-canvas" style="position:fixed;inset:0;pointer-events:none;z-index:0;opacity:0.5;"></canvas>

  <Navbar lang={lang} />
  <main style="position:relative;z-index:1;">
    <slot />
  </main>
  <Footer lang={lang} />

  <script>
    /* ── Particles ── */
    const canvas = document.getElementById('particle-canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;

    function resize() {
      canvas.width  = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    interface Particle {
      x: number; y: number;
      vx: number; vy: number;
      size: number; alpha: number;
      color: string; life: number; maxLife: number;
    }

    const COLORS = ['#ff8c00','#ff4500','#ffb347','#ff6b35','rgba(255,140,0,0.6)'];
    const particles: Particle[] = [];

    function spawn() {
      const life = 80 + Math.random() * 120;
      particles.push({
        x: Math.random() * canvas.width,
        y: canvas.height + 10,
        vx: (Math.random() - 0.5) * 0.6,
        vy: -(0.3 + Math.random() * 0.8),
        size: 0.5 + Math.random() * 1.5,
        alpha: 0,
        color: COLORS[Math.floor(Math.random() * COLORS.length)],
        life: 0,
        maxLife: life,
      });
    }

    function animateParticles() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      if (Math.random() < 0.4) spawn();
      if (Math.random() < 0.1) {
        // occasional horizontal streaks
        particles.push({
          x: 0,
          y: Math.random() * canvas.height,
          vx: 3 + Math.random() * 4,
          vy: 0,
          size: 1,
          alpha: 0,
          color: '#ff8c00',
          life: 0,
          maxLife: 40,
        });
      }

      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.life++;
        p.x += p.vx;
        p.y += p.vy;
        const ratio = p.life / p.maxLife;
        p.alpha = ratio < 0.2
          ? ratio / 0.2
          : ratio > 0.7
            ? 1 - (ratio - 0.7) / 0.3
            : 1;

        ctx.save();
        ctx.globalAlpha = p.alpha * 0.7;
        ctx.fillStyle = p.color;
        ctx.shadowBlur = 6;
        ctx.shadowColor = p.color;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();

        if (p.life >= p.maxLife) particles.splice(i, 1);
      }

      requestAnimationFrame(animateParticles);
    }
    animateParticles();

    /* ── Glitch ── */
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    function glitchBurst(el: HTMLElement) {
      el.classList.remove('is-glitching');
      void el.offsetWidth; // restart the CSS animation
      el.classList.add('is-glitching');
      setTimeout(() => el.classList.remove('is-glitching'), 450);
    }

    // Teleport: the element snaps to one or two random spots on screen, then back home.
    // Uses the `translate` property so it doesn't fight the burst's transform.
    function glitchJump(el: HTMLElement) {
      const r = el.getBoundingClientRect();
      const padX = 16, padTop = 76, padBottom = 16; // padTop clears the fixed navbar
      if (r.top < padTop || r.bottom > innerHeight - padBottom) return glitchBurst(el);

      const between = (min: number, max: number) => min < max ? min + Math.random() * (max - min) : 0;
      let hops = 1 + Math.floor(Math.random() * 2);
      (function hop() {
        if (hops-- > 0) {
          const x = between(padX - r.left, innerWidth - padX - r.right);
          const y = between(padTop - r.top, innerHeight - padBottom - r.bottom);
          el.style.translate = `${x}px ${y}px`;
          setTimeout(hop, 140 + Math.random() * 180);
        } else {
          el.style.translate = '';
        }
        glitchBurst(el);
      })();
    }

    // Wrap each letter in a span so single letters can drop out or shift.
    // Every letter repaints the parent's gradient at its own offset (--gx/--gy), so the
    // word still looks like one continuous gradient while letters move independently.
    function splitChars(el: HTMLElement) {
      const text = el.textContent!.trim();
      el.setAttribute('aria-label', text);
      el.textContent = '';
      const chars = [...text].map(c => {
        const span = document.createElement('span');
        span.className = 'glitch-char';
        span.setAttribute('aria-hidden', 'true');
        span.textContent = c;
        el.appendChild(span);
        return span;
      });
      const sync = () => {
        el.style.setProperty('--gw', el.offsetWidth + 'px');
        el.style.setProperty('--gh', el.offsetHeight + 'px');
        chars.forEach(c => {
          c.style.setProperty('--gx', -c.offsetLeft + 'px');
          c.style.setProperty('--gy', -c.offsetTop + 'px');
        });
      };
      el.classList.add('is-split');
      new ResizeObserver(sync).observe(el);
      document.fonts.ready.then(sync);
      return chars;
    }

    function shuffle<T>(items: T[]) {
      for (let i = items.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [items[i], items[j]] = [items[j], items[i]];
      }
      return items;
    }

    // Break: for a moment the word loses letters or comes apart, then snaps back.
    // Break types are dealt from a shuffled bag so the same one rarely repeats.
    let breakBag: string[] = [];
    function glitchBreak(el: HTMLElement, chars: HTMLElement[]) {
      const rand = (n: number) => (Math.random() * 2 - 1) * n;
      const hide = (c: HTMLElement) => { c.style.visibility = 'hidden'; };

      // free width to the right of the word, up to the viewport edge
      const em = parseFloat(getComputedStyle(el).fontSize);
      const last = chars[chars.length - 1];
      const room = Math.max(0, innerWidth - 16 - (el.getBoundingClientRect().left + last.offsetLeft + last.offsetWidth));

      if (!breakBag.length) {
        breakBag = shuffle(['truncate', 'holes', 'split', 'shatter', 'spread', 'spread', 'apart', 'apart']);
      }
      let mode = breakBag.pop()!;
      // the wide break needs room to travel; on narrow screens fall back to missing letters
      if (room < em * 0.6 && mode === 'spread') mode = Math.random() < 0.5 ? 'truncate' : 'holes';
      // flying apart only makes sense while the whole word is on screen
      const home = el.getBoundingClientRect();
      if (mode === 'apart' && (home.top < 76 || home.bottom > innerHeight - 16)) mode = 'holes';

      const cut = 2 + Math.floor(Math.random() * (chars.length - 2)); // keeps at least 2 letters on the left

      if (mode === 'truncate') {
        // PIER, PIE
        chars.slice(cut).forEach(hide);
      } else if (mode === 'holes') {
        // PIE RE
        const victims = chars.filter(() => Math.random() < 0.3);
        (victims.length ? victims : [chars[Math.floor(Math.random() * chars.length)]]).forEach(hide);
      } else if (mode === 'split') {
        // snapped in the middle: the two halves drift apart
        const dx = 0.1 + Math.random() * 0.12, dy = (Math.random() < 0.5 ? -1 : 1) * (0.06 + Math.random() * 0.1);
        chars.forEach((c, i) => {
          const side = i < cut ? -1 : 1;
          c.style.transform = `translate(${side * dx}em, ${side * dy}em)`;
        });
      } else if (mode === 'shatter') {
        // every letter knocked out of place, a few missing
        chars.forEach(c => {
          c.style.transform = `translate(${rand(0.12)}em, ${rand(0.12)}em) rotate(${rand(8)}deg)`;
          if (Math.random() < 0.2) hide(c);
        });
      } else if (mode === 'apart') {
        // PIE in one place, RRE in another: the word snaps at a random letter and each
        // piece teleports to its own spot on screen
        const at = 1 + Math.floor(Math.random() * (chars.length - 1));
        const placed: { l: number; t: number; r: number; b: number }[] = [];
        [chars.slice(0, at), chars.slice(at)].forEach(piece => {
          const a = piece[0].getBoundingClientRect(), z = piece[piece.length - 1].getBoundingClientRect();
          const between = (min: number, max: number) => min < max ? min + Math.random() * (max - min) : 0;
          let x = 0, y = 0;
          // a few tries to keep the pieces from landing on top of each other
          for (let tries = 0; tries < 10; tries++) {
            x = between(16 - a.left, innerWidth - 16 - z.right);
            y = between(76 - a.top, innerHeight - 16 - a.bottom);
            if (!placed.some(p => a.left + x < p.r && z.right + x > p.l && a.top + y < p.b && a.bottom + y > p.t)) break;
          }
          placed.push({ l: a.left + x, t: a.top + y, r: z.right + x, b: a.bottom + y });
          piece.forEach(c => { c.style.transform = `translate(${x}px, ${y}px)`; });
        });
      } else {
        // torn wide: PIE ...... R ...... RE. Groups are pushed apart across the free width
        const cuts = new Set<number>();
        for (let i = 1 + Math.floor(Math.random() * 3); i > 0; i--) cuts.add(Math.floor(Math.random() * chars.length));
        let left = room, x = 0, pending = cuts.size;
        chars.forEach((c, i) => {
          if (cuts.has(i)) {
            const gap = left * (--pending ? Math.random() * 0.7 : 0.5 + Math.random() * 0.5);
            left -= gap;
            x += gap;
          }
          if (x) c.style.transform = `translateX(${x}px)`;
        });
        const lost = chars.filter(() => Math.random() < 0.3);
        if (lost.length <= chars.length - 2) lost.forEach(hide);
      }
      el.classList.add('is-broken');
      glitchBurst(el);

      setTimeout(() => {
        el.classList.remove('is-broken');
        chars.forEach(c => { c.style.visibility = ''; c.style.transform = ''; });
        glitchBurst(el);
      }, 450 + Math.random() * 450);
    }

    // Idle bursts at irregular intervals, so they never read as a loop
    document.querySelectorAll<HTMLElement>('[data-glitch-idle]').forEach(el => {
      if (reduceMotion) return;
      const chars = el.hasAttribute('data-glitch-break') ? splitChars(el) : null;
      // Effects are dealt from a shuffled bag instead of rolled each time, so every
      // round is guaranteed its jumps and breaks: no long droughts of one effect
      const jump = el.hasAttribute('data-glitch-jump');
      let bag: string[] = [];
      const next = () => {
        if (!bag.length) {
          bag = shuffle(['burst', 'burst', 'burst', ...(jump ? ['jump', 'jump', 'jump'] : []), ...(chars ? ['break', 'break', 'break'] : [])]);
        }
        return bag.pop()!;
      };
      (function schedule() {
        setTimeout(() => {
          if (!document.hidden) {
            const effect = next();
            if (effect === 'break') glitchBreak(el, chars!);
            else if (effect === 'jump') glitchJump(el);
            else {
              glitchBurst(el);
              // sometimes a quick double hit
              if (Math.random() < 0.3) setTimeout(() => glitchBurst(el), 520);
            }
          }
          schedule();
        }, 2500 + Math.random() * 4500);
      })();
    });

    // Section titles decode from noise once, when scrolled into view
    const GLYPHS = '!<>-_\\/[]{}=+*^?#01';
    function decode(el: HTMLElement) {
      const text = el.dataset.text!;
      let done = 0;
      const timer = setInterval(() => {
        done += Math.max(1, Math.round(text.length / 14));
        if (done >= text.length) {
          clearInterval(timer);
          el.textContent = text;
          glitchBurst(el);
          return;
        }
        el.textContent = text.slice(0, done) + [...text.slice(done)]
          .map(c => c === ' ' ? c : GLYPHS[Math.floor(Math.random() * GLYPHS.length)])
          .join('');
      }, 40);
    }

    const titleObserver = new IntersectionObserver(
      entries => entries.forEach(e => {
        if (e.isIntersecting) {
          decode(e.target as HTMLElement);
          titleObserver.unobserve(e.target);
        }
      }),
      { threshold: 0.6 }
    );
    document.querySelectorAll<HTMLElement>('.section-title').forEach(el => {
      const text = el.textContent!.trim();
      el.classList.add('glitch');
      el.dataset.text = text;
      el.setAttribute('aria-label', text);
      if (!reduceMotion) titleObserver.observe(el);
    });

    /* ── Scroll Reveal ── */
    const observer = new IntersectionObserver(
      entries => entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          observer.unobserve(e.target);
        }
      }),
      { threshold: 0.1 }
    );
    document.querySelectorAll('[data-reveal]').forEach(el => observer.observe(el));
  </script>
</body>
</html>
